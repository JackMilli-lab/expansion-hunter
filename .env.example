# Create .env for Docker Compose. No private exchange keys are needed.
# Required before any remote dashboard exposure: generate a long random token.
COCKPIT_API_TOKEN=replace-with-a-long-random-access-token
# Optional public, read-only exchange prices/candles. Private APIs stay protected.
COCKPIT_PUBLIC_MARKET_DATA=false
# app starts the additive all-universe pre-ignition worker by default.
# Set false to keep only the existing cockpit/scanners.
COCKPIT_PRE_IGNITION_ENABLED=true
# Optional resource limit for detailed candle/flow monitoring (1-500).
# Broad universe prices remain independently configured. Render Free: 30.
COCKPIT_FAST_MONITOR_LIMIT=
# Optional independent War Room analysis bound (0 disables it; maximum 50).
# Render Free: 5, while native detailed monitoring can remain 30.
COCKPIT_DEEP_WATCH_LIMIT=
# Offline outcome/replay research starts by default. Render Free: false.
# Native monitoring, alerts, archival observations and notifications stay active.
COCKPIT_RESEARCH_ENABLED=true
# Optional Telegram delivery. Empty values disable delivery, not scanning.
COCKPIT_TELEGRAM_BOT_TOKEN=
COCKPIT_TELEGRAM_CHAT_ID=
